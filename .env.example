# .env.example — скопіюй у .env і заповни свої дані.
# Локально:  cp .env.example .env
# Docker:    compose читає цей .env автоматично.
# Railway/Render: ці ж ключі задаються у вкладці Variables сервісу.

# ---------- Обов'язково ----------
# Згенеруй: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-заміни_цей_ключ_на_свій_новий
DEBUG=False

# Хосты через кому. Для PaaS додай свій домен, напр.:
# ALLOWED_HOSTS=vector.up.railway.app,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Для HTTPS-доменів (інакше 403 в адмінці): повні URL через кому, напр.:
# CSRF_TRUSTED_ORIGINS=https://vector.up.railway.app,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=

# Публічна адреса сайту — для листів reset-password, напр.:
# FRONTEND_URL=https://vector.up.railway.app
FRONTEND_URL=http://localhost:8000

# ---------- База і медіа (міняй лише для Docker volume) ----------
# Локально лиши порожніми (= db.sqlite3 і media/ у корені проєкту).
# У docker-compose.yml вже задано /data/...
DATABASE_PATH=
MEDIA_ROOT=

# ---------- Пошта: Brevo HTTP API (рекомендовано для Railway/Render) ----------
# Railway блокує вихідний SMTP (Network is unreachable) — тому листи йдуть
# через HTTP API Brevo. Безкоштовно ~300 листів/день, свій домен НЕ потрібен:
# 1) Зареєструйся на brevo.com → Settings → Senders → додай свою Gmail-адресу
#    і підтвердь її листом, який прийде від Brevo.
# 2) SMTP & API → API Keys → Create a new API key → скопіюй (xkeysib-...).
BREVO_API_KEY=
# Має збігатися з підтвердженою в Brevo адресою (зазвичай та сама Gmail).
# Порожнє = значення EMAIL_HOST_USER.
BREVO_SENDER=

# ---------- Пошта: SMTP (локально / VPS, де SMTP не заблоковано) ----------
# Використовується лише якщо BREVO_API_KEY порожній.
# Gmail: порт 587 + USE_TLS=True, USE_SSL=False (або 465 + навпаки).
# УВАГА: комбінація 465 + USE_TLS=True зависає! EMAIL_TIMEOUT обмежує очікування.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Vector <noreply@yourdomain.com>

# ---------- HTTPS (увімкни в production з доменом і TLS) ----------
# AUTH_COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True

# ---------- Рантайм контейнера ----------
PORT=8000
# Воркерів gunicorn. Лиши 1: channels InMemory не працює між процесами.
WEB_CONCURRENCY=1

# ---------- Тільки для VPS (docker-compose + Caddy) ----------
# Публічний домен (Caddy сам випустить HTTPS). Без домена — http://localhost
# Не забудь поставити той самий домен у FRONTEND_URL, ALLOWED_HOSTS і CSRF_TRUSTED_ORIGINS вище.
DOMAIN=localhost
