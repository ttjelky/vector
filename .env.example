# .env.example — копіюй цей файл у .env і заповни свої дані

DEBUG=False

# Згенеруй новий секретний ключ командою:
# python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-заміни_цей_ключ_на_свій_новий

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=Vector <noreply@yourdomain.com>

ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# Для HTTPS production:
# AUTH_COOKIE_SECURE=True